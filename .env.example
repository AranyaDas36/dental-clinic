# Server
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dental?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SESSION_ABSOLUTE_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=30
COOKIE_NAME=dental_session
CSRF_COOKIE_NAME=dental_csrf

# Initial administrator (used only by seed:admin script — never commit real values)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dental-clinic

# Optional: public site URL used for SEO canonicals / sitemap generation helpers
PUBLIC_SITE_URL=http://localhost:5173

# Client (Vite) — public only, never put secrets here
VITE_API_BASE_URL=http://localhost:4000/api/v1

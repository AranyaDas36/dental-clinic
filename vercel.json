{
  "buildCommand": "pnpm --filter @dental/shared build && pnpm --filter @dental/client build",
  "outputDirectory": "client/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
